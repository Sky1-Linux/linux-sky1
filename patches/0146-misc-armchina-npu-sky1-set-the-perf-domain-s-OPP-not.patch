From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotschmoe <isaac@mass-engineering.com>
Date: Thu, 1 Oct 2026 08:37:31 +0800
Subject: [PATCH] misc: armchina-npu: sky1: set the perf domain's OPP, not a
 clock rate

Any write to the NPU's devfreq userspace/set_freq panics the kernel:

  Unable to handle kernel NULL pointer dereference at virtual address 000000000000002e
  pc : clk_round_rate+0x50/0x2e0
   dev_pm_opp_set_rate+0x160/0x2e8
   sky1_npu_devfreq_target+0x50/0xe0 [armchina_npu]

sky1_npu_devfreq_target() calls dev_pm_opp_set_rate() on the SCMI perf
domain's virtual device, which has no clock: the OPP table's clk is
ERR_PTR(-ENOENT) and clk_round_rate() dereferences it. Find the domain's
OPP and dev_pm_opp_set_opp() it; that requests the SCMI performance level
through the genpd (as panthor does for the GPU).

sky1_npu_devfreq_get_cur_freq() also ran a ceil lookup from devfreq's
uninitialised frequency, so cur_freq always read the lowest OPP. Report
the frequency last set instead.

Tested on a Minisforum MS-R1: 400, 600, 800 and 1200 MHz set without
error, and NPU throughput follows the setting.

Signed-off-by: hotschmoe <isaac@mass-engineering.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/misc/armchina-npu/sky1/sky1.c | 29 +++++++++++++++++++--------
 1 file changed, 21 insertions(+), 8 deletions(-)

diff --git a/drivers/misc/armchina-npu/sky1/sky1.c b/drivers/misc/armchina-npu/sky1/sky1.c
index 80daab087..72678f28b 100644
--- a/drivers/misc/armchina-npu/sky1/sky1.c
+++ b/drivers/misc/armchina-npu/sky1/sky1.c
@@ -66,6 +66,9 @@ static void remove_debugfs_dir(const char *name)
 }
 
 #ifdef CONFIG_ENABLE_DEVFREQ
+/* Last frequency set through the perf domain; 0 until the first set. */
+static unsigned long sky1_npu_freq;
+
 static int sky1_npu_devfreq_target(struct device *dev, unsigned long *freq, u32 flags)
 {
     struct dev_pm_opp *opp;
@@ -78,7 +81,21 @@ static int sky1_npu_devfreq_target(struct device *dev, unsigned long *freq, u32
         return PTR_ERR(opp);
     }
     dev_pm_opp_put(opp);
-    ret = dev_pm_opp_set_rate(cix_aipu_priv->opp_pmdomain, *freq);
+
+    /*
+     * The NPU's perf domain has no clock, so dev_pm_opp_set_rate() would
+     * pass an ERR_PTR clk to clk_round_rate(). Set the domain's OPP instead:
+     * that requests its SCMI performance level.
+     */
+    opp = dev_pm_opp_find_freq_exact(cix_aipu_priv->opp_pmdomain, *freq, true);
+    if (IS_ERR(opp)) {
+        dev_err(dev, "No perf domain opp for %lu Hz\n", *freq);
+        return PTR_ERR(opp);
+    }
+    ret = dev_pm_opp_set_opp(cix_aipu_priv->opp_pmdomain, opp);
+    dev_pm_opp_put(opp);
+    if (!ret)
+        sky1_npu_freq = *freq;
 
     dev_dbg(dev, "%s: target=%ld, current=%ld.",
                     __func__, target_freq, *freq);
@@ -88,13 +105,9 @@ static int sky1_npu_devfreq_target(struct device *dev, unsigned long *freq, u32
 
 static int sky1_npu_devfreq_get_cur_freq(struct device *dev, unsigned long *freq)
 {
-    struct dev_pm_opp *opp;
-
-    opp = dev_pm_opp_find_freq_ceil(cix_aipu_priv->opp_pmdomain, freq);
-    if (IS_ERR(opp))
-        *freq = 0;
-    else
-        dev_pm_opp_put(opp);
+    if (!sky1_npu_freq)
+        return -EAGAIN;
+    *freq = sky1_npu_freq;
     dev_dbg(dev, "%s: %ld", __func__, *freq);
 
     return 0;
-- 
